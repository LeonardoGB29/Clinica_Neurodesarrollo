# Copia este archivo como .env.local (ignorado por git) y ajusta los valores.

# URL base de la API REST (clinica-backend). Por defecto: http://localhost:8080/api/v1
# Detrás de Nginx en producción puede ser una ruta relativa, p. ej. /api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Paciente que abre la ficha de evolución (hasta que exista el módulo Pacientes). Por defecto: pac-0231
VITE_PACIENTE_ID=pac-0231
